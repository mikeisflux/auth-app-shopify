<%- include('header') %>

<div class="Polaris-Page">
  <div class="Polaris-Page-Header Polaris-Page-Header--hasPagination Polaris-Page-Header--hasNavigation">
    <div class="Polaris-Page-Header__Row">
      <div class="Polaris-Page-Header__TitleWrapper">
        <h1 class="Polaris-Header-Title">Collectible Tracker Dashboard</h1>
      </div>
      <div class="Polaris-Page-Header__RightAlign">
        <div class="Polaris-Page-Header__PrimaryActionWrapper">
          <button type="button" class="Polaris-Button Polaris-Button--primary" onclick="navigate('/app/categories')">
            <span class="Polaris-Button__Content">
              <span class="Polaris-Button__Text">View All Categories</span>
            </span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="Polaris-Page__Content">
    <div class="Polaris-BlockStack" style="--pc-block-stack-gap: var(--p-space-500);">

      <!-- Stats Cards -->
      <div class="Polaris-Layout">
        <div class="Polaris-Layout__Section Polaris-Layout__Section--oneThird">
          <div class="Polaris-Card">
            <div class="Polaris-Card__Section">
              <div class="Polaris-BlockStack" style="--pc-block-stack-gap: var(--p-space-200);">
                <p class="Polaris-Text--root Polaris-Text--headingMd">Categories</p>
                <p class="Polaris-Text--root Polaris-Text--heading2xl"><%= stats.totalCategories %></p>
                <p class="Polaris-Text--root Polaris-Text--bodySm Polaris-Text--subdued"><%= stats.activeCategories %> active</p>
              </div>
            </div>
          </div>
        </div>

        <div class="Polaris-Layout__Section Polaris-Layout__Section--oneThird">
          <div class="Polaris-Card">
            <div class="Polaris-Card__Section">
              <div class="Polaris-BlockStack" style="--pc-block-stack-gap: var(--p-space-200);">
                <p class="Polaris-Text--root Polaris-Text--headingMd">Total Items</p>
                <p class="Polaris-Text--root Polaris-Text--heading2xl"><%= stats.totalItems %></p>
                <p class="Polaris-Text--root Polaris-Text--subdued">Collectibles tracked</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Recent Categories -->
      <div class="Polaris-Layout">
        <div class="Polaris-Layout__Section">
          <div class="Polaris-Card">
            <div class="Polaris-Card__Section">
              <div class="Polaris-BlockStack" style="--pc-block-stack-gap: var(--p-space-400);">
                <div class="Polaris-InlineStack" style="justify-content: space-between;">
                  <p class="Polaris-Text--root Polaris-Text--headingMd">Recent Categories</p>
                  <button type="button" class="Polaris-Button" onclick="navigate('/app/categories')">
                    <span class="Polaris-Button__Content">
                      <span class="Polaris-Button__Text">View All</span>
                    </span>
                  </button>
                </div>

                <% if (categories.length > 0) { %>
                  <div class="Polaris-BlockStack" style="--pc-block-stack-gap: var(--p-space-300);">
                    <% categories.forEach(category => { %>
                      <div class="Polaris-Card">
                        <div class="Polaris-Card__Section">
                          <div class="Polaris-InlineStack" style="justify-content: space-between; align-items: center;">
                            <div class="Polaris-BlockStack" style="--pc-block-stack-gap: var(--p-space-100);">
                              <p class="Polaris-Text--root Polaris-Text--headingSm"><%= category.name %></p>
                              <p class="Polaris-Text--root Polaris-Text--bodySm Polaris-Text--subdued"><%= category.item_count %> items</p>
                            </div>
                            <button type="button" class="Polaris-Button" onclick="navigate('/app/categories/<%= category.id %>/items')">
                              <span class="Polaris-Button__Content">
                                <span class="Polaris-Button__Text">View Items</span>
                              </span>
                            </button>
                          </div>
                        </div>
                      </div>
                    <% }); %>
                  </div>
                <% } else { %>
                  <div class="Polaris-BlockStack" style="--pc-block-stack-gap: var(--p-space-300);">
                    <p class="Polaris-Text--root Polaris-Text--subdued">No categories yet. Create your first category to get started!</p>
                    <button type="button" class="Polaris-Button Polaris-Button--primary" onclick="navigate('/app/categories/new')">
                      <span class="Polaris-Button__Content">
                        <span class="Polaris-Button__Text">Create Category</span>
                      </span>
                    </button>
                  </div>
                <% } %>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Start Guide -->
      <div class="Polaris-Layout">
        <div class="Polaris-Layout__Section">
          <div class="Polaris-Card">
            <div class="Polaris-Card__Section">
              <div class="Polaris-BlockStack" style="--pc-block-stack-gap: var(--p-space-300);">
                <p class="Polaris-Text--root Polaris-Text--headingMd">Quick Start Guide</p>
                <div class="Polaris-BlockStack" style="--pc-block-stack-gap: var(--p-space-200);">
                  <p>1. Create categories for your collectibles</p>
                  <p>2. Add items with unique serial numbers and images</p>
                  <p>3. Add the verification widget to your storefront</p>
                  <p>4. Customers can verify their collectibles using serial numbers</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('footer') %>
