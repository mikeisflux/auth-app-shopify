  </div>

  <!-- Shopify Admin Context -->
  <script>
    // We're already embedded in Shopify admin - no need to initialize App Bridge
    // window.shopify is provided by Shopify and contains the admin API
    console.log('Shopify admin context available:', !!window.shopify);

    // Make toast helper available globally if needed
    if (window.shopify && window.shopify.toast) {
      window.shopifyToast = function(message, isError = false) {
        window.shopify.toast.show(message, {
          duration: 5000,
          isError: isError
        });
      };
    }
  </script>

  <!-- Custom JS -->
  <script src="/public/js/app.js"></script>
</body>
</html>