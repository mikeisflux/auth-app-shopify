  </div>

  <!-- Shopify App Bridge Initialization -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Check if we're in an embedded app
      const isEmbedded = window.top !== window.self;

      if (isEmbedded && window.AppBridge) {
        try {
          const app = window.AppBridge.createApp({
            apiKey: '<%= apiKey %>',
            host: '<%= host %>'
          });

          // Make app bridge available globally
          window.appBridge = {
            app: app,
            redirect: function(path) {
              const Redirect = window.AppBridge.actions.Redirect;
              app.dispatch(Redirect.create(app).set({path: path}));
            }
          };

          console.log('App Bridge initialized successfully');
        } catch (error) {
          console.error('App Bridge initialization error:', error);
        }
      } else {
        console.log('Not in embedded context or App Bridge not loaded');
      }
    });
  </script>

  <!-- Custom JS -->
  <script src="/public/js/app.js"></script>
</body>
</html>