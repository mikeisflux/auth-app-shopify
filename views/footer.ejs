  </div>

  <!-- Shopify App Bridge Initialization -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      console.log('Initializing App Bridge...');
      console.log('window.shopify:', window.shopify);
      console.log('window.shopify keys:', window.shopify ? Object.keys(window.shopify) : 'undefined');
      console.log('window["app-bridge"]:', window['app-bridge']);

      // Try the modern App Bridge API
      const AppBridge = window['app-bridge'];

      if (AppBridge && AppBridge.createApp) {
        try {
          const app = AppBridge.createApp({
            apiKey: '<%= apiKey %>',
            host: '<%= host %>',
            forceRedirect: true
          });

          // Make app bridge available globally with helper functions
          window.appBridge = {
            app: app,
            redirect: function(path) {
              const Redirect = AppBridge.actions.Redirect;
              app.dispatch(Redirect.create(app, {url: path}));
            }
          };

          console.log('App Bridge initialized successfully with modern API');
        } catch (error) {
          console.error('App Bridge initialization error:', error);
        }
      } else {
        console.error('App Bridge not available. Available globals:', Object.keys(window).filter(k => k.toLowerCase().includes('app') || k.toLowerCase().includes('shop')));
      }
    });
  </script>

  <!-- Custom JS -->
  <script src="/public/js/app.js"></script>
</body>
</html>