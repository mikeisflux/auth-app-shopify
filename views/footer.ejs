  </div>

  <!-- Modern Shopify Embedded App Script -->
  <script>
    // Modern Shopify embedded apps use window.shopify (provided automatically)
    // No need to manually initialize App Bridge

    // Make toast helper available globally
    if (window.shopify && window.shopify.toast) {
      window.shopifyToast = function(message, isError = false) {
        window.shopify.toast.show(message, {
          duration: 5000,
          isError: isError
        });
      };
    }
  </script>

  <!-- Custom JS -->
  <script src="/public/js/app.js"></script>
</body>
</html>