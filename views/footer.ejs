  </div>

  <!-- Shopify App Bridge Initialization -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      console.log('Initializing App Bridge...');
      console.log('window.shopify available:', !!window.shopify);

      if (window.shopify) {
        try {
          const app = window.shopify.createApp({
            apiKey: '<%= apiKey %>',
            host: '<%= host %>',
            forceRedirect: true
          });

          // Make app bridge available globally with helper functions
          window.appBridge = {
            app: app,
            redirect: function(path) {
              const redirect = window.shopify.Redirect.create(app);
              redirect.dispatch(window.shopify.Redirect.Action.APP, path);
            },
            showToast: function(message, isError = false) {
              const toastOptions = {
                message: message,
                duration: 5000,
                isError: isError
              };
              const toast = window.shopify.Toast.create(app, toastOptions);
              toast.dispatch(window.shopify.Toast.Action.SHOW);
            }
          };

          console.log('App Bridge initialized successfully');
        } catch (error) {
          console.error('App Bridge initialization error:', error);
        }
      } else {
        console.error('Shopify App Bridge not loaded - window.shopify is undefined');
      }
    });
  </script>

  <!-- Custom JS -->
  <script src="/public/js/app.js"></script>
</body>
</html>