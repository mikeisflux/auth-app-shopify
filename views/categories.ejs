<%- include('header') %>
<div class="Polaris-Page">
  <div class="Polaris-Page-Header">
    <div class="Polaris-Page-Header__Row">
      <div class="Polaris-Page-Header__BreadcrumbWrapper">
        <nav role="navigation">
          <a href="/app" class="Polaris-Breadcrumbs__Breadcrumb">
            <span class="Polaris-Breadcrumbs__Icon">
              <svg viewBox="0 0 20 20"><path d="M17 9H5.414l3.293-3.293a1 1 0 10-1.414-1.414l-5 5a1 1 0 000 1.414l5 5a1 1 0 001.414-1.414L5.414 11H17a1 1 0 100-2z"></path></svg>
            </span>
            <span class="Polaris-Breadcrumbs__Content">Back</span>
          </a>
        </nav>
      </div>
      <div class="Polaris-Page-Header__TitleWrapper">
        <h1 class="Polaris-Header-Title">Categories</h1>
      </div>
      <div class="Polaris-Page-Header__RightAlign">
        <button type="button" class="Polaris-Button Polaris-Button--primary" onclick="navigate('/app/categories/new')">
          <span class="Polaris-Button__Content">
            <span class="Polaris-Button__Text">Create Category</span>
          </span>
        </button>
      </div>
    </div>
  </div>

  <div class="Polaris-Page__Content">
    <% if (categories.length === 0) { %>
      <div class="Polaris-EmptyState">
        <div class="Polaris-EmptyState__ImageContainer">
          <img src="https://cdn.shopify.com/s/files/1/0262/4071/2726/files/emptystate-files.png" alt="No categories" class="Polaris-EmptyState__Image">
        </div>
        <div class="Polaris-EmptyState__Content">
          <p class="Polaris-Text--root Polaris-Text--headingLg">No categories yet</p>
          <div class="Polaris-EmptyState__Details">
            <p>Create your first category to start tracking collectibles.</p>
          </div>
          <div class="Polaris-EmptyState__Actions">
            <button type="button" class="Polaris-Button Polaris-Button--primary" onclick="navigate('/app/categories/new')">
              <span class="Polaris-Button__Content">
                <span class="Polaris-Button__Text">Create Category</span>
              </span>
            </button>
          </div>
        </div>
      </div>
    <% } else { %>
      <div class="Polaris-Layout">
        <div class="Polaris-Layout__Section">
          <div class="Polaris-Card">
            <div class="Polaris-DataTable">
              <div class="Polaris-DataTable__ScrollContainer">
                <table class="Polaris-DataTable__Table">
                  <thead>
                    <tr>
                      <th class="Polaris-DataTable__Cell Polaris-DataTable__Cell--header">Name</th>
                      <th class="Polaris-DataTable__Cell Polaris-DataTable__Cell--header">Description</th>
                      <th class="Polaris-DataTable__Cell Polaris-DataTable__Cell--header">Status</th>
                      <th class="Polaris-DataTable__Cell Polaris-DataTable__Cell--header">Items</th>
                      <th class="Polaris-DataTable__Cell Polaris-DataTable__Cell--header">Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% categories.forEach(category => { %>
                      <tr class="Polaris-DataTable__TableRow">
                        <td class="Polaris-DataTable__Cell"><%= category.name %></td>
                        <td class="Polaris-DataTable__Cell"><%= category.description || '—' %></td>
                        <td class="Polaris-DataTable__Cell">
                          <% if (category.is_active) { %>
                            <span class="Polaris-Badge Polaris-Badge--toneSuccess">Active</span>
                          <% } else { %>
                            <span class="Polaris-Badge Polaris-Badge--toneWarning">Inactive</span>
                          <% } %>
                        </td>
                        <td class="Polaris-DataTable__Cell"><%= category.item_count || 0 %> items</td>
                        <td class="Polaris-DataTable__Cell">
                          <button type="button" class="Polaris-Button Polaris-Button--plain" onclick="navigate('/app/categories/<%= category.id %>/items')">
                            <span class="Polaris-Button__Content">
                              <span class="Polaris-Button__Text">View Items</span>
                            </span>
                          </button>
                        </td>
                      </tr>
                    <% }); %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% } %>
  </div>
</div>

<script>

<%- include('footer') %>
